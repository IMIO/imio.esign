<tr metal:define-macro="session_id" i18n:domain="imio.esign">
    <td class="table_widget_label"><label i18n:translate="">Session ID</label></td>
    <td class="table_widget_value" tal:define="can_link python:view.can_display_sessions_listing_link()">
        <span tal:condition="not: can_link" tal:content="python: session_id">25452</span>
        <a tal:condition="can_link" href="#" target="_blank"
           tal:content="python: session_id"
           tal:attributes="href python:'{}#{}'.format(view.session_listing_url, session_id)">25452 - College</a>
    </td>
</tr>
<tr metal:define-macro="state" i18n:domain="imio.esign">
    <td class="table_widget_label"><label i18n:translate="">State</label></td>
    <td class="table_widget_value">
        <span tal:attributes="class string:state-title state-title-${session/state};
                              title python:view.get_state_description(session['state'])">
          <tal:block content="python:session['state']" i18n:translate="">draft</tal:block>
          <span class='far fa-question-circle' />
        </span>
    </td>
</tr>
<tr metal:define-macro="update_date" i18n:domain="imio.esign">
    <td class="table_widget_label"><label i18n:translate="">Last update</label></td>
    <td class="table_widget_value"
             tal:content="python:context.unrestrictedTraverse('@@plone').toLocalizedTime(session['last_update'], long_format=True)">
        2025-08-13 10:44
    </td>
</tr>
<tr metal:define-macro="sealed" i18n:domain="imio.esign">
    <td class="table_widget_label"><label i18n:translate="">Sealed</label></td>
    <td class="table_widget_value"
             tal:content="python:'Yes' if session['seal'] else 'No'"
             i18n:translate="">No
    </td>
</tr>
<tr metal:define-macro="external_link" i18n:domain="imio.esign">
    <td class="table_widget_label"><label i18n:translate="">Title</label></td>
    <td class="table_widget_value"
             tal:content="structure python: view.ext_session_link(session)"
             i18n:translate="">url
    </td>
</tr>
<tr metal:define-macro="signers" i18n:domain="imio.esign">
    <td class="table_widget_label"><label i18n:translate="">Signers</label></td>
    <td class="table_widget_value">
        <table class="context_viewlet_signers_table no-border no-style-table listing"
                 tal:define="signers python:session.get('signers', [])">
            <thead>
            <tr>
                <th i18n:translate="">Full name</th>
                <th i18n:translate="">Position</th>
                <th i18n:translate="">Email</th>
                <th i18n:translate="">Status</th>
            </tr>
            </thead>
            <tbody>
            <tr tal:repeat="s signers">
                <td tal:content="python:s['fullname']">Jean Dupont</td>
                <td tal:content="python:s['position']">Directeur Général</td>
                <td tal:content="python:s['email']">user1@sign.com</td>
                <td tal:content="python:s['status'] or '-'" i18n:translate="" >pending</td>
            </tr>
            </tbody>
        </table>
    </td>
</tr>
