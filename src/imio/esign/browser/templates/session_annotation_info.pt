<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
    xmlns:tal="http://xml.zope.org/namespaces/tal"
    xmlns:metal="http://xml.zope.org/namespaces/metal"
    xmlns:i18n="http://xml.zope.org/namespaces/i18n"
    i18n:domain="imio.esign">
    <body>
        <tal:section tal:repeat="section view/sections">
            <h2 tal:content="python: section[0]"></h2>
            <pre style="background: #f5f5f5; color: #333; padding: 1em; overflow: auto;"
                 tal:content="structure python: section[1]" />
        </tal:section>
    </body>
</html>
